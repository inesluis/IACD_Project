# Copy to .env and change the password. .env is git-ignored.
POSTGRES_USER=solarcast
POSTGRES_PASSWORD=solarcast
POSTGRES_DB=solarcast

# Read by the pipelines.
DATABASE_URL=postgresql://solarcast:solarcast@localhost:5432/solarcast

# Read by the database tests. Every test rolls back, so the same database is fine.
TEST_DATABASE_URL=postgresql://solarcast:solarcast@localhost:5432/solarcast

# EPREL public API key (energy label catalogue), read by api/appliances/eprel_sync.py.
EPREL_API_KEY=
